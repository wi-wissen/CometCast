<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links: https://cometcast.de/app/{CODE} opens the app (native-apps.md 20.4, 21.6);
	     needs deploy/well-known/apple-app-site-association on cometcast.de (served by the website).
	     The old form https://relay.cometcast.de/{CODE} is no Universal Link any more (the relay
	     serves no web app and its host stays out of the file); it still works as a pasted or
	     scanned link. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cometcast.de</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(COMETCAST_APP_GROUP)</string>
	</array>
</dict>
</plist>
