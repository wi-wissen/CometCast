// SPDX-License-Identifier: GPL-3.0-or-later
// The ONE place for identifiers of the iOS app. project.yml, both Info.plists and both
// entitlement files read these build settings; nothing else in ios/ contains a bundle id.
// Included by Flutter/Debug.xcconfig and Flutter/Release.xcconfig.
//
// UNCERTAIN: never opened in Xcode (docs/ios.md).

// Bundle id of the app. Same value the committed project had before XcodeGen.
COMETCAST_BUNDLE_ID = de.cometcast.cometcast

// The Broadcast Upload Extension. Must be prefixed by the app's bundle id (Apple rule for
// embedded extensions).
COMETCAST_EXTENSION_BUNDLE_ID = $(COMETCAST_BUNDLE_ID).broadcast

// App Group shared by app and extension (Developer portal: Identifiers, App Groups).
COMETCAST_APP_GROUP = group.$(COMETCAST_BUNDLE_ID)

// Name below the icon. Translations of the other strings: InfoPlist.strings (en, de).
COMETCAST_DISPLAY_NAME = Comet Cast

// Oldest iOS version. 15.0: what the committed Flutter project already used; the
// VideoToolbox low-latency encoder mode needs 14.5, UIScreen.isCaptured 11.
COMETCAST_DEPLOYMENT_TARGET = 15.0

// Custom URL scheme (placeholder, see docs/ios.md "URL scheme and universal links").
COMETCAST_URL_SCHEME = cometcast

// Team id comes from the environment or from Local.xcconfig (not committed):
//   COMETCAST_DEVELOPMENT_TEAM = ABCDE12345
#include? "Local.xcconfig"
DEVELOPMENT_TEAM = $(COMETCAST_DEVELOPMENT_TEAM)
