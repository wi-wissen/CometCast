    "relay.confirm.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server %@ was not set by your administrator and is not on the default list (%@). Only continue if you know and trust its operator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server %@ wurde nicht von Ihrem Administrator festgelegt und steht nicht auf der Standardliste (%@). Fahren Sie nur fort, wenn Sie den Betreiber kennen und ihm vertrauen."
          }
        }
      }
    },
    "relay.confirm.risk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operator of this server can see who connects, your room codes and network addresses, and can redirect the connection. Nothing is connected before you decide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betreiber dieses Servers kann sehen, wer sich verbindet, Ihre Raumcodes und Netzwerkadressen, und kann die Verbindung umleiten. Es wird nichts verbunden, bevor Sie entschieden haben."
          }
        }
      }
    },
    "relay.confirm.use": {
