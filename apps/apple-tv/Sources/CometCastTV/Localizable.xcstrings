{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comet Cast"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Comet Cast"
          }
        }
      }
    },
    "receiver.codeLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Room code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raumcode"
          }
        }
      }
    },
    "receiver.codeHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter this code on the sending device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie diesen Code auf dem sendenden Gerät ein."
          }
        }
      }
    },
    "receiver.howTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How it works"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert es"
          }
        }
      }
    },
    "receiver.how1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Comet Cast on the sending device: the app on a computer or phone, or the web page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Comet Cast auf dem sendenden Gerät: die App auf einem Computer oder Smartphone oder die Webseite."
          }
        }
      }
    },
    "receiver.how2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the same server as shown below and enter the room code."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie denselben Server wie unten angezeigt und geben Sie den Raumcode ein."
          }
        }
      }
    },
    "receiver.how3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the connection check code on both devices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleichen Sie den Verbindungs-Prüfcode auf beiden Geräten."
          }
        }
      }
    },
    "receiver.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show room code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Raumcode anzeigen"
          }
        }
      }
    },
    "receiver.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create new room"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuen Raum erstellen"
          }
        }
      }
    },
    "receiver.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden"
          }
        }
      }
    },
    "receiver.stopConfirmTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop receiving?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfang beenden?"
          }
        }
      }
    },
    "receiver.stopConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the sender is closed and the room code is no longer valid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Absender wird getrennt und der Raumcode wird ungültig."
          }
        }
      }
    },
    "receiver.keepReceiving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep receiving"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiter empfangen"
          }
        }
      }
    },
    "receiver.status.idle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not started."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gestartet."
          }
        }
      }
    },
    "receiver.status.connecting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to the server…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Server wird aufgebaut …"
          }
        }
      }
    },
    "receiver.status.checking": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the connection to the server…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung zum Server wird geprüft …"
          }
        }
      }
    },
    "receiver.status.waiting_sender": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for a sender…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf einen Absender …"
          }
        }
      }
    },
    "receiver.status.negotiating": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A sender joined. Setting up the connection…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Absender ist beigetreten. Die Verbindung wird eingerichtet …"
          }
        }
      }
    },
    "receiver.status.receiving": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receiving the screen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm wird empfangen."
          }
        }
      }
    },
    "receiver.status.peer_left": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sender left. You can keep this code and wait for a new sender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Absender hat die Verbindung verlassen. Sie können diesen Code behalten und auf einen neuen Absender warten."
          }
        }
      }
    },
    "receiver.status.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist ein Fehler aufgetreten."
          }
        }
      }
    },
    "receiver.stageWaiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected. Waiting for the screen or content from the sender…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbunden. Warten auf den Bildschirm oder Inhalte des Absenders …"
          }
        }
      }
    },
    "receiver.video": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incoming screen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehender Bildschirm"
          }
        }
      }
    },
    "receiver.transfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receiving %@… %lld %%"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird empfangen … %lld %%"
          }
        }
      }
    },
    "receiver.relayUsing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server: %@"
          }
        }
      }
    },
    "receiver.unencrypted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unencrypted connection (ws://), only suitable for a trusted local network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsselte Verbindung (ws://), nur für ein vertrauenswürdiges lokales Netzwerk geeignet."
          }
        }
      }
    },
    "receiver.menuHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Menu to stop receiving. Play/Pause shows statistics."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken Sie „Menü“, um den Empfang zu beenden. „Wiedergabe/Pause“ zeigt die Statistik."
          }
        }
      }
    },
    "sas.label": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connection check code"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindungs-Prüfcode"
          }
        }
      }
    },
    "sas.explain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices should show the same code. If they differ, stop: the connection may be intercepted. Comparing is up to you, the app does not enforce it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte sollten denselben Code anzeigen. Weichen sie ab, brechen Sie ab: Die Verbindung könnte abgefangen werden. Der Vergleich liegt bei Ihnen, die App erzwingt ihn nicht."
          }
        }
      }
    },
    "errors.bad_hello": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server did not accept the handshake. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat den Verbindungsaufbau nicht akzeptiert. Bitte versuchen Sie es erneut."
          }
        }
      }
    },
    "errors.proto_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app and the server use different protocol versions. Please update the app or use another server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App und der Server verwenden unterschiedliche Protokollversionen. Bitte aktualisieren Sie die App oder verwenden Sie einen anderen Server."
          }
        }
      }
    },
    "errors.wrong_role": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action is not allowed for this role."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion ist für diese Rolle nicht erlaubt."
          }
        }
      }
    },
    "errors.room_not_found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No room with this code exists."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt keinen Raum mit diesem Code."
          }
        }
      }
    },
    "errors.room_full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This room already has a sender."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Raum hat bereits einen Absender."
          }
        }
      }
    },
    "errors.not_in_room": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The other device is not connected anymore."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das andere Gerät ist nicht mehr verbunden."
          }
        }
      }
    },
    "errors.bad_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not understand a message. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte eine Nachricht nicht verstehen. Bitte versuchen Sie es erneut."
          }
        }
      }
    },
    "errors.altcha_required": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server wants a short check before it creates a room. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server verlangt eine kurze Prüfung, bevor er einen Raum anlegt. Bitte versuchen Sie es erneut."
          }
        }
      }
    },
    "errors.altcha_invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check was not accepted (it may have expired). Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung wurde nicht akzeptiert (möglicherweise ist sie abgelaufen). Bitte versuchen Sie es erneut."
          }
        }
      }
    },
    "errors.altcha_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check could not be completed. Please try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung konnte nicht abgeschlossen werden. Bitte versuchen Sie es erneut."
          }
        }
      }
    },
    "errors.altcha_too_hard": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server asked for a check that is too demanding for this device, so it was not started. Please try again later or contact the server operator."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server verlangt eine Prüfung, die für dieses Gerät zu aufwendig ist, und sie wurde nicht gestartet. Bitte versuchen Sie es später erneut oder wenden Sie sich an den Betreiber des Servers."
          }
        }
      }
    },
    "errors.altcha_expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The check from the server had already expired. Please try again; if it keeps happening, check that the date and time of this device are correct."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung des Servers war bereits abgelaufen. Bitte versuchen Sie es erneut; falls das wiederholt passiert, prüfen Sie Datum und Uhrzeit dieses Geräts."
          }
        }
      }
    },
    "errors.rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests from this network. Please wait a moment and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Anfragen aus diesem Netzwerk. Bitte warten Sie einen Moment und versuchen Sie es erneut."
          }
        }
      }
    },
    "errors.banned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This network is blocked for a while because of too many failed attempts. Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netzwerk ist wegen zu vieler fehlgeschlagener Versuche für kurze Zeit gesperrt. Bitte versuchen Sie es später erneut."
          }
        }
      }
    },
    "errors.forbidden": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This network is not allowed to use this server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netzwerk darf diesen Server nicht nutzen."
          }
        }
      }
    },
    "errors.server_full": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is full right now. Please try again later."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist gerade ausgelastet. Bitte versuchen Sie es später erneut."
          }
        }
      }
    },
    "errors.connection_lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection to the server was lost or could not be made."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung zum Server ist abgebrochen oder konnte nicht hergestellt werden."
          }
        }
      }
    },
    "errors.peer_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The direct connection to the other device failed. Without STUN/TURN servers this only works in the same local network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die direkte Verbindung zum anderen Gerät ist fehlgeschlagen. Ohne STUN/TURN-Server funktioniert das nur im selben lokalen Netzwerk."
          }
        }
      }
    },
    "errors.no_server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No server is selected. Choose a server first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Server ausgewählt. Wählen Sie zuerst einen Server aus."
          }
        }
      }
    },
    "errors.local_network_denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access to the local network is not allowed for this app. Allow it in the Apple TV settings under Privacy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das lokale Netzwerk ist für diese App nicht erlaubt. Erlauben Sie ihn in den Apple-TV-Einstellungen unter „Datenschutz“."
          }
        }
      }
    },
    "errors.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unknown error occurred."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unbekannter Fehler ist aufgetreten."
          }
        }
      }
    },
    "transferError.bad_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A message from the sender could not be understood and was ignored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nachricht des Absenders konnte nicht verstanden werden und wurde ignoriert."
          }
        }
      }
    },
    "transferError.unexpected_chunk": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unexpected image data was ignored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unerwartete Bilddaten wurden ignoriert."
          }
        }
      }
    },
    "transferError.too_large": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image was larger than announced and was discarded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild war größer als angekündigt und wurde verworfen."
          }
        }
      }
    },
    "transferError.size_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image arrived incomplete and was discarded."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild ist unvollständig angekommen und wurde verworfen."
          }
        }
      }
    },
    "transferError.no_transfer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A transfer ended unexpectedly and was ignored."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Übertragung wurde unerwartet beendet und ignoriert."
          }
        }
