    "relay.errors.invalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is not a valid server address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Serveradresse."
          }
        }
      }
    },
    "relay.errors.insecure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unencrypted ws:// is only allowed for localhost and local network addresses. Please use wss://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsseltes ws:// ist nur für localhost und Adressen im lokalen Netzwerk erlaubt. Bitte verwenden Sie wss://."
          }
        }
      }
    },
    "relay.errors.credentials": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address must not contain a user name or password."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse darf keinen Benutzernamen und kein Passwort enthalten."
          }
        }
      }
    },
    "relay.errors.path": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address must not contain a path, query or fragment (only an optional /ws)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse darf keinen Pfad, keine Query und kein Fragment enthalten (nur optional /ws)."
