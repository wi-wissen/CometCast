    "relay.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server"
          }
        }
      }
    },
    "relay.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server connects the two devices: room codes, connection data and network addresses pass through it. Media (screen, images) travels directly between the devices, encrypted (DTLS-SRTP), but the server carries the signalling and could in principle interfere with the key exchange. Compare the connection check code on both devices. Sender and receiver must use the same server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server verbindet die beiden Geräte: Raumcodes, Verbindungsdaten und Netzwerkadressen laufen darüber. Medien (Bildschirm, Bilder) werden direkt zwischen den Geräten übertragen, verschlüsselt (DTLS-SRTP), aber der Server vermittelt die Signalisierung und könnte den Schlüsselaustausch grundsätzlich manipulieren. Vergleichen Sie den Verbindungs-Prüfcode auf beiden Geräten. Sender und Empfänger müssen denselben Server verwenden."
          }
        }
      }
    },
    "relay.change": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change server"
