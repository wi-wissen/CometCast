    "relay.errors.insecure": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unencrypted ws:// is only allowed for localhost and local network addresses. Please use wss://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unverschlüsseltes ws:// ist nur für localhost und Adressen im lokalen Netzwerk erlaubt. Bitte verwenden Sie wss://."
          }
        }
      }
    },
    "relay.errors.credentials": {
      "extractionState": "manual",
      "localizations": {
