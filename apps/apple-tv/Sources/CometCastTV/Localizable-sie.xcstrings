    "setup.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! This screen is about to become a display device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen! Dieser Bildschirm wird zum Anzeigegerät."
          }
        }
      }
    },
    "setup.welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Afterwards anyone in the room can show here what is on their phone or laptop. With a code, no account."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach kann jeder im Raum hier zeigen, was auf seinem Handy oder Laptop ist. Mit einem Code, ohne Konto."
          }
        }
      }
    },
    "setup.welcome.start": {
      "extractionState": "manual",
      "localizations": {
