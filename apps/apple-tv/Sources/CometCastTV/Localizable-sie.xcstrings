    "idle.offline.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen is offline right now. Code and QR code come back by themselves once the network is back."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Bildschirm ist gerade offline. Sobald das Netz wieder da ist, erscheinen Code und QR-Code von selbst."
          }
        }
      }
    },
    "idle.offline.bodyBusy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server is busy right now. This screen tries again by itself."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server ist gerade ausgelastet. Dieser Bildschirm versucht es von selbst noch einmal."
