    "setup.mode.openText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone who sees the code connects at once. For small groups, teams and at home."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Code sieht, ist sofort verbunden. Für kleine Runden, Teams und zu Hause."
          }
        }
      }
    },
    "setup.mode.approvalText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person shows up here as a request and you let them in. For rooms many people use."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Person erscheint hier als Anfrage, Sie lassen sie herein. Für Räume, die viele nutzen."
          }
        }
      }
    },
    "setup.mode.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
