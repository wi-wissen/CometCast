    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comet Cast uses the local network to find servers and to receive the screen of a sending device directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Comet Cast nutzt das lokale Netzwerk, um Server zu finden und den Bildschirm eines sendenden Geräts direkt zu empfangen."
          }
        }
      }
    },
