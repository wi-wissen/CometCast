{
  "description": "validateLinkUrl: input in, normalised href (or null) out. `expect` is what apps/web/src/core/control.ts returns (WHATWG URL of Node, see the test); `expect_apple_tv` (optional) is a documented, deliberately stricter result of the Swift implementation (see apps/apple-tv/CometCastCore/Sources/CometCastCore/LinkURL.swift).",
  "cases": [
    {
      "name": "plain https",
      "input": "https://example.com/",
      "expect": "https://example.com/"
    },
    {
      "name": "plain http",
      "input": "http://example.com",
      "expect": "http://example.com/"
    },
    {
      "name": "no path",
      "input": "https://example.com",
      "expect": "https://example.com/"
    },
    {
      "name": "uppercase scheme and host",
      "input": "HTTPS://EXAMPLE.COM/Path",
      "expect": "https://example.com/Path"
    },
    {
      "name": "default port https",
      "input": "https://example.com:443/",
      "expect": "https://example.com/"
    },
    {
      "name": "default port http",
      "input": "http://example.com:80/",
      "expect": "http://example.com/"
    },
    {
      "name": "non default port",
      "input": "https://example.com:8443/x",
      "expect": "https://example.com:8443/x"
    },
    {
      "name": "port zero",
      "input": "http://example.com:0/",
      "expect": "http://example.com:0/"
    },
    {
      "name": "port too large",
      "input": "http://example.com:65536/",
      "expect": null
    },
    {
      "name": "port 65535",
      "input": "http://example.com:65535/",
      "expect": "http://example.com:65535/"
    },
    {
      "name": "empty port",
      "input": "http://example.com:/a",
      "expect": "http://example.com/a"
    },
    {
      "name": "port with letters",
      "input": "http://example.com:80a/",
      "expect": null
    },
    {
      "name": "leading zero port",
      "input": "http://example.com:0080/",
      "expect": "http://example.com/"
    },
    {
      "name": "query only",
      "input": "https://example.com?a=1",
      "expect": "https://example.com/?a=1"
    },
    {
      "name": "fragment only",
      "input": "https://example.com#x",
      "expect": "https://example.com/#x"
    },
    {
      "name": "empty query",
      "input": "https://example.com/?",
      "expect": "https://example.com/?"
    },
    {
      "name": "empty fragment",
      "input": "https://example.com/#",
      "expect": "https://example.com/#"
    },
    {
      "name": "query with quote",
      "input": "https://example.com/?a='b'",
      "expect": "https://example.com/?a=%27b%27"
    },
    {
      "name": "query with brace and caret",
      "input": "https://example.com/?a={b}^c`d",
      "expect": "https://example.com/?a={b}^c`d"
    },
    {
      "name": "path with brace caret backtick pipe",
      "input": "https://example.com/a{b}c^d`e|f",
      "expect": "https://example.com/a%7Bb%7Dc^d%60e|f"
    },
    {
      "name": "path with quote and angle",
      "input": "https://example.com/a\"b<c>d",
      "expect": "https://example.com/a%22b%3Cc%3Ed"
    },
    {
      "name": "fragment with backtick and quote",
      "input": "https://example.com/#a`b\"c<d>e",
      "expect": "https://example.com/#a%60b%22c%3Cd%3Ee"
    },
    {
      "name": "percent sequences kept",
      "input": "https://example.com/a%20b%zz%2",
      "expect": "https://example.com/a%20b%zz%2"
    },
    {
      "name": "percent in query kept",
      "input": "https://example.com/?a=%41%",
      "expect": "https://example.com/?a=%41%"
    },
    {
      "name": "non ascii path",
      "input": "https://example.com/café/ü",
      "expect": "https://example.com/caf%C3%A9/%C3%BC"
    },
    {
      "name": "non ascii query",
      "input": "https://example.com/?q=äö",
      "expect": "https://example.com/?q=%C3%A4%C3%B6"
    },
    {
      "name": "non ascii fragment",
      "input": "https://example.com/#ü",
      "expect": "https://example.com/#%C3%BC"
    },
    {
      "name": "astral in path",
      "input": "https://example.com/😀",
      "expect": "https://example.com/%F0%9F%98%80"
    },
    {
      "name": "dot segments",
      "input": "https://example.com/a/b/../c/./d",
      "expect": "https://example.com/a/c/d"
    },
    {
      "name": "dot segments above root",
      "input": "https://example.com/../../a",
      "expect": "https://example.com/a"
    },
    {
      "name": "trailing dot segment",
      "input": "https://example.com/a/b/.",
      "expect": "https://example.com/a/b/"
    },
    {
      "name": "trailing double dot",
      "input": "https://example.com/a/b/..",
      "expect": "https://example.com/a/"
    },
    {
      "name": "encoded dots",
      "input": "https://example.com/a/%2e%2E/b/%2e/c",
      "expect": "https://example.com/b/c"
    },
    {
      "name": "mixed encoded dots",
      "input": "https://example.com/a/.%2e/b/%2e./c",
      "expect": "https://example.com/c"
    },
    {
      "name": "double slash path",
      "input": "https://example.com//a//b",
      "expect": "https://example.com//a//b"
    },
    {
      "name": "backslash path",
      "input": "https://example.com\\a\\b",
      "expect": "https://example.com/a/b"
    },
    {
      "name": "backslashes after scheme",
      "input": "https:\\\\example.com\\a",
      "expect": "https://example.com/a"
    },
    {
      "name": "one slash",
      "input": "https:/example.com/a",
      "expect": "https://example.com/a"
    },
    {
      "name": "no slashes",
      "input": "https:example.com/a",
      "expect": "https://example.com/a"
    },
    {
      "name": "three slashes",
      "input": "https:///example.com/a",
      "expect": "https://example.com/a"
    },
    {
      "name": "many slashes",
      "input": "https://///example.com/a",
      "expect": "https://example.com/a"
    },
    {
