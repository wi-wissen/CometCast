{
  "description": "parseControlMessage: text in, normalised message (or null) out. `input` is the text, or `input_parts` (strings and {repeat,count}) concatenated. `expect` is what apps/web/src/core/control.ts returns; `expect_apple_tv` (optional) is a deliberate, documented difference of the Apple TV implementation.",
  "cases": [
    {
      "name": "cmd next_page",
      "input": "{\"kind\":\"cmd\",\"cmd\":\"next_page\"}",
      "expect": {
        "kind": "cmd",
        "cmd": "next_page"
      }
    },
    {
      "name": "cmd prev_page",
      "input": "{\"kind\":\"cmd\",\"cmd\":\"prev_page\"}",
      "expect": {
        "kind": "cmd",
        "cmd": "prev_page"
      }
    },
    {
      "name": "cmd stop",
      "input": "{\"kind\":\"cmd\",\"cmd\":\"stop\"}",
      "expect": {
        "kind": "cmd",
        "cmd": "stop"
      }
    },
    {
      "name": "cmd go_to_page 3",
      "input": "{\"kind\":\"cmd\",\"cmd\":{\"go_to_page\":{\"page\":3}}}",
      "expect": {
        "kind": "cmd",
        "cmd": {
          "go_to_page": {
            "page": 3
          }
        }
      }
    },
    {
